@model List<Health_Care.Models.Appointment>

@{
    ViewBag.Title = "Appointment History";

    string firstName = Session["FN"] != null
        ? Session["FN"].ToString()
        : "";

    string lastName = Session["LN"] != null
        ? Session["LN"].ToString()
        : "";

    string email = Session["Email"] != null
        ? Session["Email"].ToString()
        : "";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        Appointment History - CarePlus
    </title>


    <!-- CSS -->

    <link href="~/Content/patient-history.css"
          rel="stylesheet" />


    <!-- BOOTSTRAP -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

</head>


<body>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <div class="sidebar">


        <!-- LOGO -->

        <div class="logo">

            <i class="fa-solid fa-heart-pulse"></i>

            CarePlus

        </div>



        <!-- PATIENT PROFILE -->

        <div class="patient-mini">


            <div class="patient-icon">

                <i class="fa-solid fa-user"></i>

            </div>


            <h5>

                @firstName @lastName

            </h5>


            <p>

                @email

            </p>


        </div>



        <!-- MENU -->

        <ul class="menu">


            <!-- DASHBOARD -->

            <li>

                <a href="@Url.Action("PatientDashboard","Home")">

                    <i class="fa-solid fa-house"></i>

                    Dashboard

                </a>

            </li>



            <!-- BOOK APPOINTMENT -->

            <li>

                <a href="@Url.Action("BookAppointment","Home")">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book Appointment

                </a>

            </li>



            <!-- MY APPOINTMENTS -->

            <li>

                <a href="@Url.Action("History","Home")">

                    <i class="fa-solid fa-calendar-check"></i>

                    My Appointments

                </a>

            </li>



            <!-- PROFILE -->

            <li>

                <a href="@Url.Action("Profile","Home")">

                    <i class="fa-solid fa-user"></i>

                    My Profile

                </a>

            </li>



            <!-- HISTORY -->

            <li>

                <a href="@Url.Action("History","Home")"
                   class="active">

                    <i class="fa-solid fa-clock-rotate-left"></i>

                    History

                </a>

            </li>



            <!-- LOGOUT -->

            <li>

                <a href="@Url.Action("Logout","Home")">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    Logout

                </a>

            </li>


        </ul>


    </div>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="main-content">


        <!-- TOPBAR -->

        <div class="topbar">


            <div>

                <h3>
                    Appointment History
                </h3>


                <p>
                    View your appointment history
                </p>

            </div>



            <div class="user-info">

                <i class="fa-solid fa-user-circle"></i>

                @firstName @lastName

            </div>


        </div>



        <!-- =================================================
             CONTENT
        ================================================== -->

        <div class="history-container">


            @if (Model != null && Model.Count > 0)
            {


                <div class="table-card">


                    <div class="table-responsive">


                        <table class="table">


                            <thead>

                                <tr>

                                    <th>
                                        ID
                                    </th>

                                    <th>
                                        Doctor
                                    </th>

                                    <th>
                                        Specialization
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        Reason
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Cancellation Reason
                                    </th>

                                </tr>

                            </thead>



                            <tbody>


                                @foreach (var item in Model)
                                {


                                    <tr>


                                        <!-- ID -->

                                        <td>

                                            #@item.AppointmentId

                                        </td>



                                        <!-- DOCTOR -->

                                        <td>

                                            <strong>

                                                Dr. @item.DoctorName

                                            </strong>

                                        </td>



                                        <!-- SPECIALIZATION -->

                                        <td>

                                            @item.Specialization

                                        </td>



                                        <!-- DATE -->

                                        <td>

                                            @item.AppointmentDate.ToString("dd-MM-yyyy")

                                        </td>



                                        <!-- TIME -->

                                        <td>

                                            @item.AppointmentTime

                                        </td>



                                        <!-- REASON -->

                                        <td>

                                            @item.Reason

                                        </td>



                                        <!-- STATUS -->

                                        <td>


                                            @if (item.Status == "Confirmed")
                                            {

                                                <span class="status confirmed">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    Confirmed

                                                </span>

                                            }

                                            else if (item.Status == "Completed")
                                            {

                                                <span class="status completed">

                                                    <i class="fa-solid fa-check-double"></i>

                                                    Completed

                                                </span>

                                            }

                                            else if (item.Status == "Cancelled")
                                            {

                                                <span class="status cancelled">

                                                    <i class="fa-solid fa-circle-xmark"></i>

                                                    Cancelled

                                                </span>

                                            }

                                            else
                                            {

                                                <span class="status pending">

                                                    <i class="fa-solid fa-clock"></i>

                                                    @item.Status

                                                </span>

                                            }


                                        </td>



                                        <!-- CANCELLATION REASON -->

                                        <td>


                                            @if (item.Status == "Cancelled")
                                            {

                                                if (!string.IsNullOrEmpty(item.CancelReason))
                                                {

                                                    <div class="cancel-reason">

                                                        <i class="fa-solid fa-circle-info"></i>

                                                        <span>
                                                            @item.CancelReason
                                                        </span>

                                                    </div>

                                                }
                                                else
                                                {

                                                    <span class="no-reason">
                                                        No reason provided
                                                    </span>

                                                }

                                            }
                                            else
                                            {

                                                <span class="no-reason">
                                                    -
                                                </span>

                                            }


                                        </td>


                                    </tr>


                                }


                            </tbody>


                        </table>


                    </div>


                </div>


            }
            else
            {


                <!-- EMPTY -->

                <div class="empty-box">


                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>


                    <h3>
                        No Appointment History
                    </h3>


                    <p>
                        You have not booked any appointments yet.
                    </p>



                    <a href="@Url.Action("BookAppointment","Home")"
                       class="book-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Book Appointment

                    </a>


                </div>


            }


        </div>


    </div>


</body>

</html>