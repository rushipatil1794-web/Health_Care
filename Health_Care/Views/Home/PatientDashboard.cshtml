
@{
    Layout = null;

    string firstName = Session["FN"] != null
        ? Session["FN"].ToString()
        : "Patient";

    string lastName = Session["LN"] != null
        ? Session["LN"].ToString()
        : "";

    string email = Session["Email"] != null
        ? Session["Email"].ToString()
        : "";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Patient Dashboard - CarePlus</title>

    <link href="~/Content/patient-dashboard.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

</head>

<body>

    <div class="dashboard">


        <!-- =========================================
             SIDEBAR
        ========================================== -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="brand">

                <div class="logo">

                    <i class="fa-solid fa-heart-pulse"></i>

                </div>

                <h2>
                    Care<span>Plus</span>
                </h2>

            </div>


            <!-- PATIENT MINI PROFILE -->

            <div class="patient-mini">

                <div class="profile-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h3>
                        @firstName @lastName
                    </h3>

                    <p>
                        Patient
                    </p>

                </div>

            </div>


            <!-- SIDEBAR MENU -->

            <nav class="menu">


                <!-- Dashboard -->

                <a href="@Url.Action("PatientDashboard", "Home")"
                   class="active">

                    <i class="fa-solid fa-house"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- Book Appointment -->

                <a href="@Url.Action("BookAppointment", "Home")">

                    <i class="fa-solid fa-calendar-plus"></i>

                    <span>
                        Book Appointment
                    </span>

                </a>


                <!-- My Appointments -->

                <a href="#">

                    <i class="fa-solid fa-calendar-check"></i>

                    <span>
                        My Appointments
                    </span>

                </a>


               

                <!-- Profile -->

                <a href="\Home\Profile">

                    <i class="fa-solid fa-user"></i>

                    <span>
                        My Profile
                    </span>

                </a>


                <!-- History -->

                <a href="\Home\History">

                    <i class="fa-solid fa-clock-rotate-left"></i>

                    <span>
                        Appointment History
                    </span>

                </a>

            </nav>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="@Url.Action("Logout", "Home")">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </aside>



        <!-- =========================================
             MAIN CONTENT
        ========================================== -->

        <main class="main-content">


            <!-- TOP BAR -->

            <header class="topbar">


                <div>

                    <h1>
                        Patient Dashboard
                    </h1>

                    <p>
                        Manage your healthcare easily
                    </p>

                </div>


                <div class="top-profile">


                    <!-- Notification -->

                    <div class="notification">

                        <i class="fa-regular fa-bell"></i>

                        <span>
                            2
                        </span>

                    </div>


                    <!-- User -->

                    <div class="top-user">


                        <div class="user-icon">

                            <i class="fa-solid fa-user"></i>

                        </div>


                        <div>

                            <strong>
                                @firstName @lastName
                            </strong>

                            <small>
                                @email
                            </small>

                        </div>


                    </div>

                </div>

            </header>



            <!-- =========================================
                 WELCOME SECTION
            ========================================== -->

            <section class="welcome">


                <div>

                    <p class="welcome-small">
                        Welcome back 👋
                    </p>

                    <h2>
                        Hello, @firstName!
                    </h2>

                    <p>
                        Take care of your health with CarePlus.
                        Book appointments and manage your healthcare
                        from one place.
                    </p>

                </div>


                <div class="welcome-icon">

                    <i class="fa-solid fa-heart-pulse"></i>

                </div>

            </section>



            <!-- =========================================
                 DATABASE STATISTICS
            ========================================== -->

            <section class="stats">


                <!-- TOTAL APPOINTMENTS -->

                <div class="stat-card">


                    <div class="stat-icon blue">

                        <i class="fa-solid fa-calendar-check"></i>

                    </div>


                    <div>

                        <h3>
                            @ViewBag.TotalAppointments
                        </h3>

                        <p>
                            Total Appointments
                        </p>

                    </div>

                </div>



                <!-- DOCTORS VISITED -->

                <div class="stat-card">


                    <div class="stat-icon green">

                        <i class="fa-solid fa-user-doctor"></i>

                    </div>


                    <div>

                        <h3>
                            @ViewBag.DoctorsVisited
                        </h3>

                        <p>
                            Doctors Visited
                        </p>

                    </div>

                </div>



                <!-- PENDING -->

                <div class="stat-card">


                    <div class="stat-icon orange">

                        <i class="fa-solid fa-clock"></i>

                    </div>


                    <div>

                        <h3>
                            @ViewBag.PendingAppointments
                        </h3>

                        <p>
                            Pending Appointments
                        </p>

                    </div>

                </div>



                <!-- CONFIRMED -->

                <div class="stat-card">


                    <div class="stat-icon purple">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>


                    <div>

                        <h3>
                            @ViewBag.ConfirmedAppointments
                        </h3>

                        <p>
                            Confirmed Appointments
                        </p>

                    </div>

                </div>


            </section>



            <!-- =========================================
                 APPOINTMENT + QUICK ACTIONS
            ========================================== -->

            <div class="content-grid">


                <!-- UPCOMING APPOINTMENTS -->

                <section class="card"
                         id="appointments">


                    <div class="card-header">


                        <div>

                            <h2>
                                My Appointments
                            </h2>

                            <p>
                                Your appointment information
                            </p>

                        </div>


                        <a href="@Url.Action("BookAppointment", "Home")"
                           class="view-btn">

                            Book New

                        </a>


                    </div>



                    <!-- Appointment 1 -->

                    <div class="appointment">


                        <div class="doctor-icon">

                            <i class="fa-solid fa-user-doctor"></i>

                        </div>


                        <div class="appointment-info">

                            <h3>
                                Appointment
                            </h3>

                            <p>
                                Your appointment details are stored
                                in the database.
                            </p>

                        </div>


                        <div class="appointment-status confirmed">

                            Active

                        </div>

                    </div>


                    <!-- No hard-coded doctor details here.
                         We will make this section dynamic next. -->


                </section>



                <!-- QUICK ACTIONS -->

                <section class="card">


                    <div class="card-header">


                        <div>

                            <h2>
                                Quick Actions
                            </h2>

                            <p>
                                Manage your healthcare
                            </p>

                        </div>


                    </div>



                    <div class="quick-actions">


                        <!-- BOOK -->

                        <a href="@Url.Action("BookAppointment", "Home")"
                           class="quick-card">

                            <i class="fa-solid fa-calendar-plus"></i>

                            <span>
                                Book Appointment
                            </span>

                        </a>


                        <!-- Logout -->

                        <a href="@Url.Action("Logout", "Home")"
                            class="quick-card">

                            <i class="fa-solid fa-user-doctor"></i>

                            <span>
                                Log Out

                            </span>

                        </a>


                        <!-- PROFILE -->

                        <a href="#profile"
                           class="quick-card">

                            <i class="fa-solid fa-user"></i>

                            <span>
                                My Profile
                            </span>

                        </a>


                        <!-- HISTORY -->

                        <a href="#history"
                           class="quick-card">

                            <i class="fa-solid fa-clock-rotate-left"></i>

                            <span>
                                History
                            </span>

                        </a>


                    </div>

                </section>


            </div>



            <!-- =========================================
                 HEALTH TIP
            ========================================== -->

            <section class="health-tip">


                <div class="tip-icon">

                    <i class="fa-solid fa-heart"></i>

                </div>


                <div>

                    <h3>
                        Health Tip
                    </h3>

                    <p>
                        Drink enough water, eat healthy food,
                        exercise regularly and don't forget
                        your regular health checkups.
                    </p>

                </div>


            </section>



            <!-- =========================================
                 FOOTER
            ========================================== -->

            <footer>

                © 2026 CarePlus Healthcare.
                All Rights Reserved.

            </footer>


        </main>

    </div>


</body>
</html>

