@model List<Health_Care.Models.Appointment>

@{
    Layout = null;

    string adminName =
        Session["AdminName"] != null
        ? Session["AdminName"].ToString()
        : "Admin";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Admin Dashboard - CarePlus</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/Content/admin-dashboard.css" />

</head>

<body>


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <i class="fa-solid fa-heart-pulse"></i>

            CarePlus

        </div>


        <nav>

            <a href="@Url.Action("Dashboard","Admin")"
               class="active">

                <i class="fa-solid fa-chart-pie"></i>

                Dashboard

            </a>


            <a href="@Url.Action("Patients","Admin")">

                <i class="fa-solid fa-users"></i>

                Patients

            </a>


            <a href="@Url.Action("Doctors","Admin")">

                <i class="fa-solid fa-user-doctor"></i>

                Doctors

            </a>


            <a href="@Url.Action("Appointments","Admin")">

                <i class="fa-solid fa-calendar-check"></i>

                Appointments

            </a>


            <a href="@Url.Action("Profile","Admin")">

                <i class="fa-solid fa-user"></i>

                My Profile

            </a>


            <a href="@Url.Action("Logout","Admin")">

                <i class="fa-solid fa-right-from-bracket"></i>

                Logout

            </a>

        </nav>

    </aside>


    <!-- MAIN -->

    <main class="main-content">


        <header class="topbar">

            <div>

                <h1>Dashboard</h1>

                <p>Welcome back, @adminName</p>

            </div>


            <div class="admin-info">

                <div class="admin-avatar">

                    <i class="fa-solid fa-user-shield"></i>

                </div>

                <div>

                    <strong>@adminName</strong>

                    <small>Administrator</small>

                </div>

            </div>

        </header>


        <!-- STAT CARDS -->

        <section class="stats-grid">


            <div class="stat-card">

                <div class="stat-icon patients">

                    <i class="fa-solid fa-users"></i>

                </div>

                <div>

                    <span>Total Patients</span>

                    <h2>@ViewBag.TotalPatients</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon doctors">

                    <i class="fa-solid fa-user-doctor"></i>

                </div>

                <div>

                    <span>Total Doctors</span>

                    <h2>@ViewBag.TotalDoctors</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon appointments">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

                <div>

                    <span>Total Appointments</span>

                    <h2>@ViewBag.TotalAppointments</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon pending">

                    <i class="fa-solid fa-clock"></i>

                </div>

                <div>

                    <span>Pending</span>

                    <h2>@ViewBag.Pending</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon confirmed">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <span>Confirmed</span>

                    <h2>@ViewBag.Confirmed</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon completed">

                    <i class="fa-solid fa-check-double"></i>

                </div>

                <div>

                    <span>Completed</span>

                    <h2>@ViewBag.Completed</h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon cancelled">

                    <i class="fa-solid fa-circle-xmark"></i>

                </div>

                <div>

                    <span>Cancelled</span>

                    <h2>@ViewBag.Cancelled</h2>

                </div>

            </div>

        </section>


        <!-- RECENT APPOINTMENTS -->

        <section class="content-card">

            <div class="section-header">

                <div>

                    <h2>Recent Appointments</h2>

                    <p>Latest appointment records</p>

                </div>

                <a href="@Url.Action("Appointments","Admin")">

                    View All

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Patient</th>

                            <th>Doctor</th>

                            <th>Date</th>

                            <th>Time</th>

                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    #@item.AppointmentId
                                </td>

                                <td>
                                    @item.FirstName
                                    @item.LastName
                                </td>

                                <td>
                                    Dr. @item.DoctorName
                                </td>

                                <td>
                                    @item.AppointmentDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>
                                    @item.AppointmentTime
                                </td>

                                <td>

                                    <span class="status @item.Status.ToLower()">

                                        @item.Status

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </main>
    <script>

    function confirmDelete()
    {
        var result = confirm(
            "Are you sure you want to delete this doctor?"
        );

        return result;
    }

    </script>
</body>

</html>