@model Health_Care.Models.patient

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>CarePlus | Login</title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- Login CSS -->

    <link href="~/Content/login.css"
          rel="stylesheet" />

</head>


<body>


    <div class="login-container">


        <!-- ===================================== -->
        <!-- LEFT SIDE -->
        <!-- ===================================== -->

        <div class="login-left">


            <div class="overlay"></div>


            <div class="left-content">


                <!-- LOGO -->

                <div class="logo">

                    <div class="logo-icon">

                        <i class="fa-solid fa-heart-pulse"></i>

                    </div>

                    <span>CarePlus</span>

                </div>


                <!-- TITLE -->

                <div class="welcome-content">

                    <h1>
                        Your Health,
                        <br />
                        Our Priority.
                    </h1>

                    <p>
                        Access your healthcare account
                        securely and manage your health
                        with CarePlus.
                    </p>

                </div>


                <!-- FEATURES -->

                <div class="features">


                    <div class="feature-item">

                        <div class="feature-icon">

                            <i class="fa-solid fa-shield-heart"></i>

                        </div>

                        <div>

                            <h5>Secure & Private</h5>

                            <p>
                                Your health information is protected.
                            </p>

                        </div>

                    </div>


                    <div class="feature-item">

                        <div class="feature-icon">

                            <i class="fa-solid fa-user-doctor"></i>

                        </div>

                        <div>

                            <h5>Expert Healthcare</h5>

                            <p>
                                Connect with trusted healthcare services.
                            </p>

                        </div>

                    </div>


                    <div class="feature-item">

                        <div class="feature-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <h5>24/7 Access</h5>

                            <p>
                                Manage your healthcare anytime.
                            </p>

                        </div>

                    </div>


                </div>


            </div>

        </div>



        <!-- ===================================== -->
        <!-- RIGHT SIDE -->
        <!-- ===================================== -->

        <div class="login-right">


            <div class="login-box">


                <!-- MOBILE LOGO -->

                <div class="mobile-logo">

                    <div class="logo-icon">

                        <i class="fa-solid fa-heart-pulse"></i>

                    </div>

                    <span>CarePlus</span>

                </div>


                <!-- HEADER -->

                <div class="login-header">

                    <h2>
                        Welcome Back
                    </h2>

                    <p>
                        Login to your CarePlus account
                    </p>

                </div>


                <!-- ERROR MESSAGE -->

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        @ViewBag.Message

                    </div>
                }


                <!-- ===================================== -->
                <!-- LOGIN FORM -->
                <!-- ===================================== -->

                <form action="@Url.Action("Loginform", "Home")"
                      method="post"
                      id="loginForm">


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="Email">

                            Email Address

                        </label>


                        <div class="input-box">

                            <i class="fa-regular fa-envelope"></i>


                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   placeholder="Enter your email"
                                   required />

                        </div>

                    </div>



                    <!-- PASSWORD -->

                    <div class="form-group">

                        <div class="label-row">

                            <label for="Password">

                                Password

                            </label>


                            <a href="#"
                               class="forgot-password">

                                Forgot Password?

                            </a>

                        </div>


                        <div class="input-box">

                            <i class="fa-solid fa-lock"></i>


                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   placeholder="Enter your password"
                                   required />


                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword()">

                                <i class="fa-regular fa-eye"
                                   id="eyeIcon"></i>

                            </button>

                        </div>

                    </div>



                    <!-- REMEMBER ME -->

                    <div class="remember-row">


                        <label class="remember">

                            <input type="checkbox"
                                   name="RememberMe" />

                            <span>
                                Remember me
                            </span>

                        </label>


                    </div>



                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="login-btn">

                        <span>
                            Login to CarePlus
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>


                </form>



                <!-- ===================================== -->
                <!-- REGISTER -->
                <!-- ===================================== -->

                <div class="register-section">

                    <span>
                        Don't have an account?
                    </span>


                    <a href="@Url.Action("Registeration", "Home")"
                       class="register-link">

                        Create New Account

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>



                <!-- SECURITY -->

                <div class="security-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <span>
                        Your information is securely protected
                    </span>

                </div>


            </div>

        </div>


    </div>



    <!-- ===================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================== -->

    <script>

                function togglePassword() {

                    const password =
                        document.getElementById("Password");

                    const icon =
                        document.getElementById("eyeIcon");


                    if (password.type === "password") {

                        password.type = "text";

                        icon.classList.remove("fa-eye");

                        icon.classList.add("fa-eye-slash");

                    }
                    else {

                        password.type = "password";

                        icon.classList.remove("fa-eye-slash");

                        icon.classList.add("fa-eye");

                    }

                }

    </script>


</body>

</html>